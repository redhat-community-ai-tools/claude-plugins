def import_results(args):
    """Import test results from Excel/CSV file and create/update test runs"""
    try:
        try:
            import openpyxl
        except ImportError:
            print(json.dumps({
                "status": "failed",
                "error": "openpyxl package is required for Excel import. Install it with: pip install openpyxl"
            }, indent=2), file=sys.stderr)
            return 1

        from datetime import datetime

        project_id = args.project or DEFAULT_PROJECT
        file_path = args.file

        # Parse update-test-run parameter
        update_test_runs = {}
        if args.update_test_run:
            # Format: "OSE/20260426-1455" or "aws:OSE/20260426-1455,vsphere:OSE/20260426-1456_2"
            if ":" in args.update_test_run:
                # Multiple platforms
                for mapping in args.update_test_run.split(","):
                    platform, test_run_id = mapping.strip().split(":")
                    update_test_runs[platform.strip()] = test_run_id.strip()
            else:
                # Single test run ID - will be used for first platform found
                update_test_runs["_single_"] = args.update_test_run.strip()

        # Parse platforms filter
        platform_filter = None
        if args.platforms:
            platform_filter = [p.strip() for p in args.platforms.split(",")]

        # Determine file type
        if file_path.endswith('.xlsx'):
            wb = openpyxl.load_workbook(file_path)
            sheets = wb.sheetnames
        else:
            print(json.dumps({"status": "failed", "error": "Only Excel (.xlsx) files are supported"}, indent=2), file=sys.stderr)
            return 1

        # Read Variants sheet first if it exists
        variants_by_platform = {}
        if 'Variants' in sheets:
            variants_sheet = wb['Variants']
            for row in range(2, variants_sheet.max_row + 1):
                platform = variants_sheet.cell(row, 1).value
                variant = variants_sheet.cell(row, 2).value
                job_url = variants_sheet.cell(row, 3).value
                build_date = variants_sheet.cell(row, 4).value

                if platform and variant:
                    if platform not in variants_by_platform:
                        variants_by_platform[platform] = []
                    variants_by_platform[platform].append({
                        "variant": variant,
                        "job_url": job_url,
                        "build_date": build_date
                    })

        results = []

        for sheet_name in sheets:
            if sheet_name.lower() in ['summary', 'variants']:
                continue

            # Apply platform filter if specified
            if platform_filter and sheet_name not in platform_filter:
                print(f"Skipping {sheet_name}: Not in platform filter", file=sys.stderr)
                continue

            sheet = wb[sheet_name]

            # Validate header row (optional but recommended)
            header_row = [str(cell.value).strip().lower() if cell.value else "" for cell in sheet[1]]
            expected_headers = ["test id", "title", "status"]
            if len(header_row) >= 3 and not any(expected in header_row[:3] for expected in expected_headers):
                print(f"Warning: {sheet_name} sheet may have unexpected column layout. Expected columns: Test ID, Title, Status", file=sys.stderr)

            # Parse test results from sheet
            test_cases = []
            for row in range(2, sheet.max_row + 1):
                test_id = sheet.cell(row, 1).value
                title = sheet.cell(row, 2).value
                status = sheet.cell(row, 3).value
                prow_url = sheet.cell(row, 4).value  # Column D contains Prow URL

                if test_id and title:
                    # Normalize test_id
                    if isinstance(test_id, int):
                        test_id = f"OCP-{test_id}"
                    elif not str(test_id).startswith("OCP-"):
                        test_id_str = str(test_id).strip()
                        # Skip invalid IDs
                        if not test_id_str.isdigit():
                            continue
                        test_id = f"OCP-{test_id}"

                    test_cases.append({
                        "id": test_id,
                        "title": title,
                        "status": status,
                        "prow_url": prow_url
                    })

            if not test_cases:
                print(f"Skipping {sheet_name}: No test cases found", file=sys.stderr)
                continue

            # Check if updating existing test run
            test_run_id = None
            is_update = False
            if sheet_name in update_test_runs:
                test_run_id = update_test_runs[sheet_name]
                is_update = True
                print(f"\nUpdating existing test run for {sheet_name}: {test_run_id}", file=sys.stderr)
            elif "_single_" in update_test_runs:
                # Use _single_ sentinel only once for the first sheet, then remove it
                test_run_id = update_test_runs["_single_"]
                del update_test_runs["_single_"]  # Remove so it's not reused
                is_update = True
                print(f"\nUpdating existing test run for {sheet_name}: {test_run_id}", file=sys.stderr)
            else:
                # Create new test run
                title = args.title_template.replace("{platform}", sheet_name).replace("{date}", datetime.now().strftime('%Y-%m-%d'))

                test_case_ids = [tc["id"] for tc in test_cases]

                create_result = get_test_run_mgr().create_test_run(
                    title=title,
                    template=args.template,
                    project_id=project_id,
                    test_case_ids=test_case_ids
                )

                if create_result.get("status") not in ["success", "partial"]:
                    print(f"Failed to create test run for {sheet_name}: {create_result.get('error')}", file=sys.stderr)
                    continue

                test_run_id = create_result.get("test_run_id")
                print(f"\nCreated test run for {sheet_name}: {test_run_id}", file=sys.stderr)

            # Update test run description with variant links (if variants exist for this platform)
            if sheet_name in variants_by_platform:
                variants = variants_by_platform[sheet_name]
                description_lines = ["Test Run Variants:", ""]

                for variant_info in variants:
                    variant = variant_info.get("variant", "")
                    job_url = variant_info.get("job_url", "")
                    build_date = variant_info.get("build_date", "")

                    if job_url:
                        description_lines.append(f"- {variant}: {job_url} (Build Date: {build_date})")
                    else:
                        description_lines.append(f"- {variant}: (Build Date: {build_date})")

                description = "\n".join(description_lines)

                # Update test run description
                desc_result = get_test_run_mgr().update_test_run_description(
                    test_run_id=test_run_id,
                    description=description,
                    project_id=project_id
                )

                if desc_result.get("status") == "success":
                    print(f"Updated description with {len(variants)} variant(s)", file=sys.stderr)
                else:
                    print(f"Warning: Failed to update description: {desc_result.get('error')}", file=sys.stderr)

            # Update test results
            passed = 0
            failed = 0

            for tc in test_cases:
                # Determine result
                result = "passed"  # default
                if tc.get("status"):
                    status_str = str(tc["status"]).lower()
                    if "pass" in status_str:
                        result = "passed"
                    elif "fail" in status_str:
                        result = "failed"
                    elif "block" in status_str:
                        result = "blocked"

                # Build comment with Prow URL for failed tests
                comment = None
                if result == "failed" and tc.get("prow_url"):
                    prow_url = tc["prow_url"]
                    comment = f"Failure: {prow_url}"

                # Update result
                update_result = get_test_run_mgr().update_test_result(
                    test_run_id=test_run_id,
                    test_case_id=tc["id"],
                    result=result,
                    project_id=project_id,
                    comment=comment
                )

                if update_result.get("status") == "success":
                    if result == "passed":
                        passed += 1
                    elif result == "failed":
                        failed += 1

            # Update test run status to finished
            finish_result = get_test_run_mgr().update_test_run_status(
                test_run_id=test_run_id,
                status="finished",
                project_id=project_id
            )

            if finish_result.get("status") != "success":
                print(f"Warning: Failed to set test run status to finished: {finish_result.get('error')}", file=sys.stderr)

            # Construct URL for test run
            if is_update:
                # For updates, construct URL from test_run_id
                tr_id = test_run_id.split("/")[-1] if "/" in test_run_id else test_run_id
                url = f"https://polarion.engineering.redhat.com/polarion/redirect/project/{project_id}/testrun?id={tr_id}"
            else:
                # For new runs, use URL from create_result
                url = create_result.get("url")

            results.append({
                "platform": sheet_name,
                "test_run_id": test_run_id,
                "url": url,
                "passed": passed,
                "failed": failed,
                "total": len(test_cases)
            })

        # Print summary
        print(json.dumps({
            "status": "success",
            "test_runs": results,
            "total_runs": len(results)
        }, indent=2))

        return 0

    except Exception as e:
        print(json.dumps({"status": "failed", "error": str(e)}, indent=2), file=sys.stderr)
        return 1


def main():
    parser = argparse.ArgumentParser(
        description="Polarion CLI - Test case and test run management tool",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--project", "-p", help=f"Polarion project ID (default: {DEFAULT_PROJECT})")

    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # test-connection command
    test_conn_parser = subparsers.add_parser("test-connection", help="Test Polarion connection")

    # create command
    create_parser = subparsers.add_parser("create", help="Create a new test case")
    create_parser.add_argument("--title", "-t", required=True, help="Test case title")
    create_parser.add_argument("--description", "-d", required=True, help="Test case description")
    create_parser.add_argument("--test-steps", help="Test steps (newline-separated)")
    create_parser.add_argument("--expected-results", help="Expected results (newline-separated, one per step)")
    create_parser.add_argument("--severity", default="should_have",
                               choices=["must_have", "should_have", "nice_to_have", "will_not_have"],
                               help="Test case severity")
    create_parser.add_argument("--status", default="draft", help="Initial status")

    # get command
    get_parser = subparsers.add_parser("get", help="Get test case details")
    get_parser.add_argument("test_case_id", help="Test case ID (e.g., OCP-12345)")

    # search command
    search_parser = subparsers.add_parser("search", help="Search for test cases")
    search_parser.add_argument("query", help="Search query")
    search_parser.add_argument("--limit", type=int, default=50, help="Maximum results")

    # update command
    update_parser = subparsers.add_parser("update", help="Update test case")
    update_parser.add_argument("test_case_id", help="Test case ID (e.g., OCP-12345)")
    update_parser.add_argument("--title", "-t", help="New title")
    update_parser.add_argument("--description", "-d", help="New description")
    update_parser.add_argument("--severity", choices=["must_have", "should_have", "nice_to_have", "will_not_have"])
    update_parser.add_argument("--status", help="New status")

    # add-test-steps command
    add_steps_parser = subparsers.add_parser("add-test-steps", help="Add/update test steps (auto-backs up and replaces existing steps)")
    add_steps_parser.add_argument("test_case_id", help="Test case ID (e.g., OCP-12345)")
    add_steps_parser.add_argument("--test-steps", required=True, help="Test steps (newline-separated)")
    add_steps_parser.add_argument("--expected-results", help="Expected results (newline-separated, one per step)")

    # restore-test-steps command
    restore_steps_parser = subparsers.add_parser("restore-test-steps", help="Restore test steps from backup file")
    restore_steps_parser.add_argument("backup_file", help="Path to backup file (e.g., /tmp/polarion-backup-OCP-32615-steps.json)")

    # create-test-run command
    create_run_parser = subparsers.add_parser("create-test-run", help="Create a new test run")
    create_run_parser.add_argument("--title", "-t", required=True, help="Test run title")
    create_run_parser.add_argument("--template", default="Empty", help="Test run template (default: Empty)")
    create_run_parser.add_argument("--test-case-ids", help="Comma-separated test case IDs (e.g., OCP-12345,OCP-12346)")
    create_run_parser.add_argument("--query", help="Lucene query to select test cases")

    # update-test-result command
    update_result_parser = subparsers.add_parser("update-test-result", help="Update test result in a test run")
    update_result_parser.add_argument("test_run_id", help="Test run ID")
    update_result_parser.add_argument("test_case_id", help="Test case ID (e.g., OCP-12345)")
    update_result_parser.add_argument("--result", "-r", required=True,
                                      choices=["passed", "failed", "blocked"],
                                      help="Test result")
    update_result_parser.add_argument("--comment", "-c", help="Comment/notes")
    update_result_parser.add_argument("--executed-by", help="User who executed the test")

    # get-test-run-status command
    get_run_parser = subparsers.add_parser("get-test-run-status", help="Get test run status and statistics")
    get_run_parser.add_argument("test_run_id", help="Test run ID")

    # import-results command
    import_parser = subparsers.add_parser("import-results", help="Import test results from Excel file and create test runs")
    import_parser.add_argument("file", help="Path to Excel file (.xlsx)")
    import_parser.add_argument("--title-template", default="Test Run - {platform} - {date}",
                               help="Test run title template (use {platform} and {date} placeholders)")
    import_parser.add_argument("--template", default="Empty", help="Test run template (default: Empty)")
    import_parser.add_argument("--update-test-run", help="Update existing test run ID instead of creating new (format: OSE/20260426-1455 or platform:id,platform:id)")
    import_parser.add_argument("--platforms", help="Only process specific platforms (comma-separated: aws,vsphere)")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        return 1

    # Route to appropriate handler
    handlers = {
        "test-connection": test_connection,
        "create": create_test_case,
        "get": get_test_case,
        "search": search_test_cases,
        "update": update_test_case,
        "add-test-steps": add_test_steps,
        "restore-test-steps": restore_test_steps,
        "create-test-run": create_test_run,
        "update-test-result": update_test_result,
        "get-test-run-status": get_test_run_status,
        "import-results": import_results,
    }

    handler = handlers.get(args.command)
    if handler:
        return handler(args)
    else:
        print(f"Unknown command: {args.command}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
