# Initialize client
client = PolarionClient(POLARION_URL, POLARION_TOKEN, VERIFY_SSL)

# Lazy-load test run manager (only when needed for test run commands)
_test_run_mgr = None

def get_test_run_mgr():
    """Get or initialize test run manager"""
    global _test_run_mgr
    if _test_run_mgr is None:
        try:
            from test_runs import TestRunManager
            _test_run_mgr = TestRunManager(client)
        except ImportError:
            print("ERROR: Test run management requires polarion-mcp-server with test_runs module", file=sys.stderr)
            print("Update polarion-mcp-server to the latest version", file=sys.stderr)
            sys.exit(1)
    return _test_run_mgr


def test_connection(args):
    """Test connection to Polarion"""
    try:
        result = client.test_connection(args.project or DEFAULT_PROJECT)
        print(json.dumps(result, indent=2))
        return 0 if result.get("status") in ["ok", "success"] else 1
    except Exception as e:
        print(json.dumps({"status": "failed", "error": str(e)}, indent=2), file=sys.stderr)
        return 1


def create_test_case(args):
    """Create a new test case"""
    try:
        # Parse test steps into list of dicts if provided
        test_steps_list = None
        if args.test_steps:
            steps = args.test_steps.strip().split('\n')
            expected = args.expected_results.strip().split('\n') if args.expected_results else []
            # Pad expected results if shorter than steps
            while len(expected) < len(steps):
                expected.append("")

            test_steps_list = [
                {"step": step.strip(), "expectedResult": expected[i].strip()}
                for i, step in enumerate(steps)
                if step.strip()
            ]

        result = client.create_test_case(
            title=args.title,
            description=args.description,
            project_id=args.project or DEFAULT_PROJECT,
            test_steps=test_steps_list,
            severity=args.severity,
            status=args.status
        )
        print(json.dumps(result, indent=2))
        return 0 if result.get("status") == "success" else 1
    except Exception as e:
        print(json.dumps({"status": "failed", "error": str(e)}, indent=2), file=sys.stderr)
        return 1


